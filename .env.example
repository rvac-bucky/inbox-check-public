# Run python3 scripts/setup_env.py to create .env with generated local secrets.
PUBLIC_ORIGIN=http://127.0.0.1:8094
LOCAL_DEV=1
SITE_NAME=Inbox Check
DB_PATH=/data/cases.db
DATA_ENCRYPTION_KEY=
BOOTSTRAP_KEY=
SCREENING_ROUTE=direct
EVIDENCE_SELECTION=rules
# Typed classification (a dedicated, spending-capped key is recommended).
OPENROUTER_API_KEY=
CLASSIFIER_MODEL=typesafe/jev-1.13
# OCR / grounded evidence selection: choose ONE of these configurations.
# Option A: HTTPS OpenAI-compatible chat-completions API, JSON mode + vision.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Option B: Azure OpenAI. Leave AI_* blank when using Azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Leave all four blank for web-only operation. M365 Graph application credentials.
MAILCHECK_TENANT_ID=
MAILCHECK_CLIENT_ID=
MAILCHECK_CLIENT_SECRET=
MAILCHECK_MAILBOX=
# Optional: only domains inside the SAME authenticated Exchange tenant.
MAILCHECK_INTERNAL_DOMAINS=
MAILCHECK_POLL_SECONDS=20
USER_HOURLY_LIMIT=10
DAILY_ANALYSIS_LIMIT=100
